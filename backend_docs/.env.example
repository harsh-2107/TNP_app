# =============================================================================
# Cloudflare R2 Configuration
# =============================================================================
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# Presigned URL expiry (seconds)
R2_UPLOAD_URL_EXPIRY_SECONDS=300
R2_DOWNLOAD_URL_EXPIRY_SECONDS=3600

# =============================================================================
# File Limits
# =============================================================================
MAX_PROFILE_RESUMES=2
MAX_FILE_SIZE_BYTES=5242880

# =============================================================================
# Application
# =============================================================================
SHARE_URL_BASE=https://placements.example.com

# Environment: "development" or "production"
# WARNING: InMemoryPendingUploadStore is only allowed in "development".
# The application will refuse to start in "production" without a persistent
# PendingUploadStore implementation.
ENVIRONMENT=development
